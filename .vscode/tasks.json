{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-debug",
      "type": "shell",
      "command": "cmake --build --preset linux-debug -j",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "test-debug",
      "type": "shell",
      "command": "ctest --preset linux-debug --output-on-failure",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "build+test sanitize",
      "type": "shell",
      "command": "cmake --build --preset linux-sanitize -j && ctest --preset linux-sanitize --output-on-failure",
      "problemMatcher": ["$gcc"]
    }
  ]
}
